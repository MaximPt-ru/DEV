{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "C: сборка",
            "type": "shell",
            "command": "gcc",
            "args": [
                "-std=c11", "-Wall", "-Wextra", "-Wpedantic", "-g",
                "${file}",
                "-o", "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "group": "build",
            "problemMatcher": ["$gcc"]
        },
        {
            "label": "C: сборка и запуск",
            "type": "shell",
            "command": "${fileDirname}\\${fileBasenameNoExtension}.exe",
            "dependsOn": "C: сборка",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": []
        }
    ]
}